<ui:FluentWindow x:Class="Droprr.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Droprr"
                 Title="Droprr Settings" Width="780" Height="860" MinWidth="640" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <local:MaskedTokenConverter x:Key="MaskedToken" />
        <local:PlatformSymbolConverter x:Key="PlatformSymbol" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- A labeled on/off row inside a tile. -->
        <Style x:Key="ToggleRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Droprr Settings" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,4,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,16" />

                <!-- Hero: this device -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Tile}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="{StaticResource RadiusTile}"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,16,0" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="28" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Pair a phone…" Icon="{ui:SymbolIcon QrCode24}"
                                   Style="{StaticResource PrimaryActionButton}" Click="OnPair" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="This device" Style="{StaticResource Caption}" />
                            <ui:TextBox x:Name="DeviceName" Margin="0,4,0,8" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240"
                                        AutomationProperties.Name="Device name" />
                            <WrapPanel>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Port" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <ui:TextBox x:Name="Port" Width="88" Padding="6,2" AutomationProperties.Name="Port" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
                                    <TextBlock x:Name="DeviceCountChip" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Devices -->
                <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Devices" Style="{StaticResource TileTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                   Text="Click a name to rename it. Add a device shows the code phones and browsers scan." />
                        <!-- One row per device: its glyph, an editable name, what it is, and its actions. Computers keep their
                             address, port, and token under Details. -->
                        <ItemsControl x:Name="PeerList" AutomationProperties.Name="Devices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Peer}">
                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}"
                                                           ToolTip="Remove" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                                                           Click="OnRemovePeer" Margin="4,0,0,0" />
                                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon PlugConnected24}"
                                                           ToolTip="Test: check that it answers, and over which path"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Test {0}'}" Click="OnTestPeer" />
                                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource RadiusTile}"
                                                        Background="{DynamicResource AccentTintBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="{Binding Platform, Converter={StaticResource PlatformSymbol}}" FontSize="16"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <!-- Looks like text until clicked; then it's a normal box to rename in. -->
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                                             BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                             ToolTip="Click to rename" AutomationProperties.Name="Device name" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Expander Header="Details" Margin="44,4,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Tailscale host" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                                PlaceholderText="Its Tailscale name (empty if paired over Wi-Fi)" AutomationProperties.Name="Tailscale host" />
                                                    <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                                HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Port" />
                                                    <TextBlock Grid.Row="2" Text="Token" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <ui:PasswordBox Grid.Row="2" Grid.Column="1" x:Name="TokenBox" Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    PlaceholderText="From that computer's Settings" AutomationProperties.Name="Token" />
                                                </Grid>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyDevices" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"
                                   Text="No devices yet. Choose Add a device and scan the code with a phone." />
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button Content="Add a device" Icon="{ui:SymbolIcon Add24}" Style="{StaticResource TonalButton}" Click="OnPair" />
                            <ui:Button Content="Add a computer by address" Icon="{ui:SymbolIcon Desktop24}" Margin="8,0,0,0" Click="OnAddPeer" />
                            <ui:Button x:Name="RemoveBrowsersButton" Icon="{ui:SymbolIcon Globe24}" Margin="8,0,0,0" Click="OnRemoveBrowsers"
                                       Visibility="Collapsed" ToolTip="Browsers that connected from the website" />
                        </WrapPanel>
                        <TextBlock x:Name="TestResult" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <!-- Droprr devices discovered on this network that aren't paired yet (LAN pairing). -->
                        <StackPanel x:Name="NearbyPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="Nearby on this network" Style="{StaticResource BodyStrongText}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Text="Droprr devices on this Wi-Fi. Pairing shows the same code on both screens." />
                            <ItemsControl x:Name="NearbyList" AutomationProperties.Name="Nearby devices">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NearbyDevice}">
                                        <DockPanel Margin="0,0,0,8">
                                            <ui:Button DockPanel.Dock="Right" Content="Pair" Icon="{ui:SymbolIcon Link24}" Style="{StaticResource TonalButton}"
                                                       Visibility="{Binding PairVisibility}"
                                                       AutomationProperties.Name="{Binding Name, StringFormat='Pair with {0}'}" Click="OnPairNearby" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PairedLabel}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Visibility="{Binding LabelVisibility}" />
                                            <ui:SymbolIcon Symbol="{Binding Platform, Converter={StaticResource PlatformSymbol}}" FontSize="20"
                                                           Margin="0,0,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Receiving -->
                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Receiving" Style="{StaticResource TileTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="Save to (empty for Downloads\Droprr)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0"
                                       ToolTip="Browse" AutomationProperties.Name="Browse for a save folder" Click="OnBrowse" />
                            <ui:TextBox x:Name="SaveFolder" AutomationProperties.Name="Save received items to" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ToggleRow}">
                            <ui:ToggleSwitch x:Name="CopyTextBox" DockPanel.Dock="Right" AutomationProperties.Name="Copy received text and links to the clipboard" />
                            <StackPanel>
                                <TextBlock Text="Copy text and links to the clipboard" TextWrapping="Wrap" />
                                <TextBlock Text="Kept out of clipboard history" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource ToggleRow}">
                            <ui:ToggleSwitch x:Name="CopyFilesBox" DockPanel.Dock="Right" AutomationProperties.Name="Auto-copy received items to clipboard" />
                            <StackPanel>
                                <TextBlock Text="Auto-copy received items to clipboard" TextWrapping="Wrap" />
                                <TextBlock Text="Files too, and images as pictures" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource ToggleRow}">
                            <ui:ToggleSwitch x:Name="LocalNetworkBox" DockPanel.Dock="Right" AutomationProperties.Name="Local network"
                                             Click="OnLocalNetworkToggled" />
                            <StackPanel>
                                <TextBlock Text="Local network" TextWrapping="Wrap" />
                                <TextBlock Text="Send and receive over Wi-Fi too, not only Tailscale" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Shown when the firewall rule for the local network is missing, or Windows blocks a Droprr copy. -->
                        <StackPanel x:Name="FirewallPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock x:Name="FirewallText" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <ui:Button x:Name="FirewallButton" Content="Allow Droprr on your private network"
                                       Icon="{ui:SymbolIcon ShieldCheckmark24}" Style="{StaticResource TonalButton}" Click="OnAllowFirewall" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Token -->
                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Token" Style="{StaticResource TileTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                   Text="Devices that send to this PC use it. Pairing a phone hands it over for you. Keep it private." />
                        <ui:TextBox x:Name="TokenText" IsReadOnly="True" AutomationProperties.Name="Token"
                                    FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button x:Name="ShowTokenButton" Content="Show" Icon="{ui:SymbolIcon Eye24}" Margin="0,0,8,8" Click="OnShowToken" />
                            <ui:Button Content="Copy" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,8" Click="OnCopyToken" />
                            <ui:Button Content="New token" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,8" Click="OnNewToken" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource TileTitle}" />
                        <!-- Style: the same four as the Mac and iPhone, in the same order. -->
                        <TextBlock Text="Style" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <ListBox x:Name="StyleList" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Style" SelectionChanged="OnStyleChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- The ring marks the current style. -->
                                                <Border x:Name="Ring" CornerRadius="{StaticResource RadiusTile}" BorderThickness="2"
                                                        BorderBrush="Transparent" Padding="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource SelectedTileTextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:StyleSwatch}">
                                    <StackPanel>
                                        <!-- Mini drawing: the style's surface, a chip, and its main button. -->
                                        <Border Height="40" CornerRadius="{Binding Radius}" Background="{Binding Back}"
                                                BorderBrush="{Binding Edge}" BorderThickness="1" Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="22" Height="14" CornerRadius="{Binding ButtonRadius}" Background="{Binding Chip}" Margin="0,0,4,0" />
                                                <Border Width="30" Height="14" CornerRadius="{Binding ButtonRadius}" Background="{Binding Button}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontFamily="{Binding TitleFont}" FontWeight="SemiBold" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Colors" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <ListBox x:Name="ThemeList" Background="Transparent" BorderThickness="0" Padding="0"
                                 AutomationProperties.Name="Theme" SelectionChanged="OnThemeChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="ToolTip" Value="{Binding Name}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <StackPanel>
                                                    <!-- The ring marks the current theme. -->
                                                    <Border x:Name="Ring" CornerRadius="{StaticResource RadiusTile}" BorderThickness="2"
                                                            BorderBrush="Transparent" Padding="2">
                                                        <ContentPresenter />
                                                    </Border>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ThemeSwatch}">
                                    <StackPanel>
                                        <!-- Mini preview: the theme's surface and tile, with its accent and secondary dots. -->
                                        <Border Height="44" CornerRadius="6" Background="{Binding Surface}" Padding="6">
                                            <Border CornerRadius="4" Background="{Binding Tile}" BorderBrush="{Binding Border}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="14" Height="14" Fill="{Binding Accent}" Margin="0,0,4,0" />
                                                    <Ellipse Width="14" Height="14" Fill="{Binding Secondary}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Margin="0,4,0,0">
                            <ComboBox x:Name="ModeBox" DockPanel.Dock="Right" MinWidth="120" AutomationProperties.Name="Light or dark mode"
                                      SelectionChanged="OnModeChanged">
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                                <ComboBoxItem Content="System" Tag="system" />
                            </ComboBox>
                            <TextBlock Text="Mode" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Windows -->
                <Border Grid.Row="7" Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Windows" Style="{StaticResource TileTitle}" Margin="0,0,0,0" />
                        <DockPanel Style="{StaticResource ToggleRow}">
                            <ui:ToggleSwitch x:Name="StartWithWindowsBox" DockPanel.Dock="Right" AutomationProperties.Name="Start Droprr when I sign in to Windows" />
                            <TextBlock Text="Start Droprr when I sign in" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ToggleRow}">
                            <ui:ToggleSwitch x:Name="StartMenuBox" DockPanel.Dock="Right" AutomationProperties.Name="Add Droprr to the Start menu and Windows Search" />
                            <TextBlock Text="Show in the Start menu and Windows Search" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:Button Content="Open settings file" Icon="{ui:SymbolIcon DocumentEdit24}" Appearance="Transparent"
                                   Margin="-8,12,0,0" Click="OnOpenFile" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="24,12,24,16" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right" Content="Save" Icon="{ui:SymbolIcon Save24}" Style="{StaticResource PrimaryActionButton}"
                       Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
            <ui:Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="OnCancel" />
            <TextBlock x:Name="Error" DockPanel.Dock="Right" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow x:Class="Droprr.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Droprr Settings" Width="720" Height="780" MinWidth="560" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Droprr Settings" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,12">
                <TextBlock Text="Settings" Style="{StaticResource TitleText}" />

                <!-- This PC -->
                <TextBlock Text="This PC" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Device name" />
                            <TextBlock Text="The name other devices see" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox x:Name="DeviceName" Width="240" AutomationProperties.Name="Device name" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Port" />
                            <TextBlock Text="53318 unless every device is set to something else" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox x:Name="Port" Width="120" AutomationProperties.Name="Port" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Folder24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Save received items to" />
                            <TextBlock Text="Leave empty for Downloads\Droprr" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="SaveFolder" Width="220" AutomationProperties.Name="Save received items to" />
                        <ui:Button Content="Browse…" Margin="8,0,0,0" AutomationProperties.Name="Browse for a save folder" Click="OnBrowse" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon ClipboardText24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Copy received text and links to the clipboard" />
                            <TextBlock Text="Kept out of clipboard history and cloud clipboard" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="CopyTextBox" AutomationProperties.Name="Copy received text and links to the clipboard" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Clipboard24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Auto-copy received items to clipboard" />
                            <TextBlock Text="Also copies received files, and images as pictures."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="CopyFilesBox" AutomationProperties.Name="Auto-copy received items to clipboard" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <TextBlock Text="Start Droprr when I sign in to Windows" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="StartWithWindowsBox" AutomationProperties.Name="Start Droprr when I sign in to Windows" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Search24}">
                    <ui:CardControl.Header>
                        <TextBlock Text="Add Droprr to the Start menu and Windows Search" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="StartMenuBox" AutomationProperties.Name="Add Droprr to the Start menu and Windows Search" />
                </ui:CardControl>

                <!-- Token -->
                <TextBlock Text="Token" Style="{StaticResource SectionHeader}" />
                <ui:Card>
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Key24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Every device that sends to this PC needs this token. Pairing a phone hands it over for you. Keep it private." />
                        </DockPanel>
                        <DockPanel Margin="32,12,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="New token" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" Click="OnNewToken" />
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Icon="{ui:SymbolIcon Copy24}" Margin="8,0,0,0" Click="OnCopyToken" />
                            <ui:Button DockPanel.Dock="Right" x:Name="ShowTokenButton" Content="Show" Icon="{ui:SymbolIcon Eye24}" Margin="8,0,0,0" Click="OnShowToken" />
                            <ui:TextBox x:Name="TokenText" IsReadOnly="True" AutomationProperties.Name="Token" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" />
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Devices -->
                <TextBlock Text="Devices" Style="{StaticResource SectionHeader}" />
                <ui:Card>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                   Text="Computers by Tailscale name. Turn on iPhone for phones: items for them wait on this PC until the phone collects them." />
                        <DataGrid x:Name="PeerGrid" AutomationProperties.Name="Devices" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                  MinHeight="120" GridLinesVisibility="None" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Tailscale host" Binding="{Binding Host}" Width="2*" />
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
                                <DataGridCheckBoxColumn Header="iPhone" Binding="{Binding IsPhone, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                        ElementStyle="{StaticResource {x:Type CheckBox}}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" />
                                <DataGridTextColumn Header="Token (if different)" Binding="{Binding Token}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Content="Add device" Icon="{ui:SymbolIcon Add24}" Click="OnAddPeer" />
                            <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="OnRemovePeer" />
                            <ui:Button Content="Pair a phone…" Icon="{ui:SymbolIcon QrCode24}" Margin="8,0,0,0" Click="OnPair" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel Margin="24,12,24,16" LastChildFill="False">
                <ui:Button Content="Open settings file" Icon="{ui:SymbolIcon DocumentEdit24}" Appearance="Transparent" Click="OnOpenFile" />
                <ui:Button DockPanel.Dock="Right" Content="Save" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                           Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
                <ui:Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="OnCancel" />
                <TextBlock x:Name="Error" DockPanel.Dock="Right" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

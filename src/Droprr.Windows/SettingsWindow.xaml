<Window x:Class="Droprr.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Droprr Settings" Width="640" Height="720" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,4">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="This PC" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Device name" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DeviceName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="Port" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Save received items to" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,5" Margin="8,0,0,0" Click="OnBrowse" />
                            <TextBox x:Name="SaveFolder" />
                        </DockPanel>
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start Droprr when I sign in to Windows" Margin="0,14,0,0" />
                        <CheckBox x:Name="StartMenuBox" Content="Add Droprr to the Start menu and Windows Search" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Token" Style="{StaticResource SectionHeader}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                                   Text="Every device and shortcut that sends to this PC needs this token. Keep it private." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="New token" Padding="12,5" Margin="8,0,0,0" Click="OnNewToken" />
                            <Button DockPanel.Dock="Right" Content="Copy" Padding="12,5" Margin="8,0,0,0" Click="OnCopyToken" />
                            <Button DockPanel.Dock="Right" x:Name="ShowTokenButton" Content="Show" Padding="12,5" Margin="8,0,0,0" Click="OnShowToken" />
                            <TextBox x:Name="TokenText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Devices" Style="{StaticResource SectionHeader}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                                   Text="Computers by Tailscale name. Turn on iPhone for phones: items for them wait on this PC until they run &quot;Get from PC&quot;." />
                        <DataGrid x:Name="PeerGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                  MinHeight="120" GridLinesVisibility="None" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Tailscale host" Binding="{Binding Host}" Width="2*" />
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
                                <DataGridCheckBoxColumn Header="iPhone" Binding="{Binding IsPhone, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="Token (if different)" Binding="{Binding Token}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Add device" Padding="12,5" Click="OnAddPeer" />
                            <Button Content="Remove" Padding="12,5" Margin="8,0,0,0" Click="OnRemovePeer" />
                            <Button Padding="12,5" Margin="8,0,0,0" Click="OnPair">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED14;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0" />
                                    <TextBlock Text="Pair a phone…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="20,8,20,20" LastChildFill="False">
            <Button Content="Open settings file" Padding="12,5" Click="OnOpenFile" />
            <Button DockPanel.Dock="Right" Content="Save" Padding="24,5" Margin="8,0,0,0" IsDefault="True" Click="OnSave"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="16,5" IsCancel="True" />
            <TextBlock x:Name="Error" DockPanel.Dock="Right" Foreground="IndianRed" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>

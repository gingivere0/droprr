<Window x:Class="Droprr.ReceiveProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Droprr" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="16">
        <TextBlock Text="Receiving…" FontWeight="SemiBold" />
        <ProgressBar x:Name="Bar" Height="4" Margin="0,10,0,8" Maximum="100" />
        <TextBlock x:Name="Detail" Opacity="0.75" FontSize="12" />
    </StackPanel>
</Window>

<ui:FluentWindow x:Class="Droprr.PairWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pair a phone" Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="AppTitleBar" Title="Pair a phone" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="24,4,24,24">
            <TextBlock Text="Pair a phone" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border x:Name="CodePanel" CornerRadius="12" Background="White" Padding="16" HorizontalAlignment="Center">
                <Image x:Name="Code" Width="280" Height="280" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <StackPanel x:Name="PairedPanel" Visibility="Collapsed" Height="312">
                <ui:SymbolIcon Symbol="CheckmarkCircle48" Filled="True" FontSize="80" HorizontalAlignment="Center" Margin="0,88,0,12"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="PairedText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="ScanHint" Text="Scan with your iPhone camera" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock x:Name="Details" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:InfoBar x:Name="PrivacyNote" Margin="0,16,0,0" IsOpen="True" IsClosable="False" Severity="Warning" Title="Keep this code private"
                        Message="It contains your Droprr token. Anyone who scans it can send files to this PC, so only show it to your own phone." />
            <ui:InfoBar x:Name="Error" Margin="0,8,0,0" IsOpen="False" IsClosable="False" Severity="Error" Title="Can't pair right now" />

            <ui:Button Content="Done" HorizontalAlignment="Right" Appearance="Primary" Padding="24,6" Margin="0,16,0,0"
                       IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>

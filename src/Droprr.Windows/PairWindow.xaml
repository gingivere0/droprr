<ui:FluentWindow x:Class="Droprr.PairWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pair a phone" Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="AppTitleBar" Title="Pair a phone" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="{StaticResource WindowPadding}">
            <TextBlock Text="Pair a phone" Style="{StaticResource TitleText}" Margin="0,0,0,16" />

            <Border x:Name="CodePanel" CornerRadius="{StaticResource RadiusFeature}" Background="{StaticResource QrPlateBrush}"
                    Padding="{StaticResource FeaturePadding}" HorizontalAlignment="Center">
                <Image x:Name="Code" Width="280" Height="280" AutomationProperties.Name="Pairing QR code" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <Grid x:Name="PairedPanel" Visibility="Collapsed" Height="312">
                <StackPanel VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle48" Filled="True" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="PairedText" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ScanHint" Text="Scan with your iPhone camera" Style="{StaticResource SubtitleText}"
                       HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock x:Name="Details" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" />

            <ui:InfoBar x:Name="PrivacyNote" Margin="0,16,0,0" IsOpen="True" IsClosable="False" Severity="Warning" Title="Keep this code private"
                        Message="It contains your Droprr token. Anyone who scans it can send files to this PC, so only show it to your own phone." />
            <ui:InfoBar x:Name="Error" Margin="0,8,0,0" IsOpen="False" IsClosable="False" Severity="Error" Title="Can't pair right now" />

            <!-- Wi-Fi pairing needs the local network listener: when it's off, say why, and offer the fix here. -->
            <Border x:Name="WifiPanel" Style="{StaticResource Tile}" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="WifiTitle" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="WifiText" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ui:Button x:Name="AllowButton" Content="Allow Droprr on your private network" Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               Style="{StaticResource TonalButton}" Click="OnAllow" />
                </StackPanel>
            </Border>

            <ui:Button Content="Done" HorizontalAlignment="Right" Style="{StaticResource PrimaryActionButton}" Margin="0,16,0,0"
                       IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>

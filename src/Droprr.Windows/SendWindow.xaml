<ui:FluentWindow x:Class="Droprr.SendWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Droprr"
                 Title="Send with Droprr" Width="640" SizeToContent="Height" MinWidth="560" MinHeight="520"
                 WindowStartupLocation="CenterScreen" AllowDrop="True"
                 DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <local:PlatformSymbolConverter x:Key="PlatformSymbol" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- "N waiting x": a secondary-tint chip. -->
        <Style x:Key="WaitingBadge" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryTintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryTintBrush}" />
            <Setter Property="MouseOverBackground" Value="{DynamicResource ThemeSecondaryTintBrush}" />
            <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ThemeSecondaryTextBrush}" />
            <Setter Property="PressedBackground" Value="{DynamicResource ThemeSecondaryTintBrush}" />
            <Setter Property="PressedForeground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel>
        <ui:TitleBar x:Name="AppTitleBar" Title="Send with Droprr" ShowMaximize="False">
            <ui:TitleBar.TrailingContent>
                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" BorderThickness="0"
                           ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettings" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Margin="{StaticResource WindowPadding}">
            <!-- Title row -->
            <TextBlock Text="Send to" Style="{StaticResource SubtitleText}" Margin="0,0,0,12" />

            <!-- Device tiles in a row; the selected one is filled with the accent. -->
            <ListBox x:Name="PeerBox" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Devices">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="140" />
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnPeerTileClick" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Tile" CornerRadius="{DynamicResource LookTileRadius}" BorderThickness="1"
                                            Padding="12" Background="{DynamicResource ThemeTileBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}" Effect="{DynamicResource LookTileEffect}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedTileBrush}" />
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SelectedTileTextBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SelectedTileTextBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:Peer}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <!-- Icon well: accent tint normally; a soft well in the selected text color when selected. -->
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource RadiusTile}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectedWellBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:SymbolIcon Symbol="{Binding Platform, Converter={StaticResource PlatformSymbol}}" FontSize="16">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectedTileTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Border>
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Style="{StaticResource WaitingBadge}"
                                           Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}"
                                           ToolTip="{Binding ClearWaitingLabel}" AutomationProperties.Name="{Binding ClearWaitingLabel}"
                                           Click="OnClearWaiting">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding WaitingLabel}" VerticalAlignment="Center" />
                                        <ui:SymbolIcon Symbol="Dismiss12" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </DockPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="{Binding Note}" FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis" Opacity="0.8"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="EmptyState" Style="{StaticResource Tile}" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">
                    No devices yet.
                    <Hyperlink Click="OnSettings">Open Settings</Hyperlink>
                    to add one, or pair your iPhone with its QR code.
                </TextBlock>
            </Border>

            <!-- Drop tile (large, left) and the message tile (secondary, right) -->
            <Grid Height="224">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                               Stroke="{DynamicResource ThemeBorderBrush}" Fill="{DynamicResource ThemeTileBrush}" />
                    <ListBox x:Name="FileList" DisplayMemberPath="Name" Margin="8,8,8,48" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Files to send" />
                    <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,24">
                        <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusTile}" Background="{DynamicResource AccentTintBrush}">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Drop files or paste" Style="{StaticResource BodyStrongText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Ctrl+V pastes files or text" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8">
                        <ui:Button Content="Add files…" Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Click="OnAddFiles" />
                        <ui:Button Content="Clear" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Margin="4,0,0,0" Click="OnClearFiles" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Tile}" Background="{DynamicResource ThemeSecondaryTintBrush}"
                        BorderBrush="{DynamicResource ThemeSecondaryTintBrush}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <!-- Icon well on the secondary tile: secondaryText fill, glyph in the tile color. -->
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource RadiusTile}"
                                    Background="{DynamicResource ThemeSecondaryTextBrush}" Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="16" Foreground="{DynamicResource ThemeTileBrush}" />
                            </Border>
                            <TextBlock Text="Text or link" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeSecondaryTextBrush}" />
                        </DockPanel>
                        <ui:TextBox x:Name="MessageText" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                    PlaceholderText="Type or paste text or a link" AutomationProperties.Name="Text or link" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Received: newest first, each with Copy, Show in folder, and remove buttons (like a downloads list). -->
            <Border Style="{StaticResource Tile}" Margin="0,12,0,0" Padding="16,12,8,8">
                <StackPanel>
                    <TextBlock Text="Received" Style="{StaticResource TileTitle}" Margin="0,0,0,8" />
                    <TextBlock x:Name="ReceivedEmpty" Text="Nothing received yet." Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ListBox x:Name="ReceivedList" MaxHeight="200" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Received items"
                             KeyDown="OnReceivedKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
                                <EventSetter Event="MouseLeftButtonUp" Handler="OnReceivedClick" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" CornerRadius="{StaticResource RadiusChip}" Padding="8,6" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RecentItem}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="{StaticResource RadiusTile}"
                                            Background="{DynamicResource AccentTintBrush}" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Padding="6"
                                               ToolTip="Remove from list" AutomationProperties.Name="Remove from list" Click="OnRemoveRecent" />
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen20}" Padding="6"
                                               ToolTip="Show in folder" AutomationProperties.Name="Show in folder" Click="OnShowRecent"
                                               Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}"
                                               IsEnabled="{Binding IsAvailable}" />
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Copy20}" Padding="6"
                                               ToolTip="Copy" AutomationProperties.Name="Copy" Click="OnCopyRecent"
                                               IsEnabled="{Binding IsAvailable}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Status tile -->
            <!-- The progress bar lies over the tile's bottom edge when the tile is up, so a send after a send
                 changes nothing's height (the window sizes to its content). -->
            <Grid Margin="0,12,0,0">
                <Border x:Name="SuccessTile" Style="{StaticResource Tile}" Visibility="Collapsed"
                        Background="{DynamicResource SuccessFillBrush}" BorderBrush="{DynamicResource SuccessFillBrush}" Padding="12">
                    <DockPanel>
                        <ui:SymbolIcon x:Name="SuccessIcon" DockPanel.Dock="Left" Symbol="CheckmarkCircle24" Filled="True" FontSize="20"
                                       Margin="0,0,8,0" Foreground="{DynamicResource SuccessTextBrush}" />
                        <TextBlock x:Name="SuccessText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" />
                    </DockPanel>
                </Border>
                <ProgressBar x:Name="Progress" Style="{StaticResource BrandProgressBar}" Visibility="Collapsed" VerticalAlignment="Bottom" />
            </Grid>
            <ui:InfoBar x:Name="StatusBar" Margin="0,12,0,0" IsOpen="False" IsClosable="True" />

            <!-- Bottom bar: a secondary button on the left, the primary Send on the right. -->
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="SendClipboardButton" Content="Send clipboard" Icon="{ui:SymbolIcon Clipboard24}"
                           Style="{StaticResource TonalButton}" Margin="0,0,8,0"
                           ToolTip="Send what's on the clipboard to the selected device" Click="OnSendClipboard" />
                <ui:Button x:Name="SendButton" Content="Send" Icon="{ui:SymbolIcon Send24}"
                           Style="{StaticResource PrimaryActionButton}" IsDefault="True" ToolTip="Send (Ctrl+Enter)" Click="OnSend" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>

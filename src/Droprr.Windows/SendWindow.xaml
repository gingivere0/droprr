<Window x:Class="Droprr.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send with Droprr" Width="480" Height="600" MinWidth="380" MinHeight="500"
        WindowStartupLocation="CenterScreen" AllowDrop="True" FontFamily="{StaticResource AppFont}"
        DragOver="OnDragOver" Drop="OnDrop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Click="OnSettings" ToolTip="Settings" Padding="8,4"
                    AutomationProperties.Name="Settings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <TextBlock Text="Send to" Opacity="0.8" VerticalAlignment="Bottom" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <Button x:Name="WaitingBadge" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center"
                    Visibility="Collapsed" Click="OnClearWaiting" ToolTip="Clear the items waiting for this phone">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="WaitingText" />
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                               Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        <ComboBox x:Name="PeerBox" SelectionChanged="OnPeerChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Note}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        </DockPanel>

        <Border Grid.Row="2" x:Name="DropZone" CornerRadius="8" BorderThickness="1.5"
                BorderBrush="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
            <Grid>
                <ListBox x:Name="FileList" DisplayMemberPath="Name" Margin="4" BorderThickness="0" Background="Transparent" />
                <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32"
                               HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="Drop files here" Margin="0,8,0,0" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,16">
            <Button Content="Add files…" Padding="12,5" Click="OnAddFiles" />
            <Button Content="Clear" Padding="12,5" Margin="8,0,0,0" Click="OnClearFiles" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Text or link" Margin="0,0,0,6" Opacity="0.8" />
        <TextBox Grid.Row="5" x:Name="MessageText" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="6" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Paste" Padding="12,5" Click="OnPaste" />
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Padding="24,5" IsDefault="True" Click="OnSend"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>

        <StackPanel Grid.Row="7" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed" Margin="0,0,0,8" />
            <TextBlock x:Name="EmptyState" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed">
                No devices yet.
                <Hyperlink Click="OnSettings">Open Settings</Hyperlink>
                to add one, or run "Get from PC" on your iPhone once.
            </TextBlock>
            <TextBlock x:Name="Status" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>

<ui:FluentWindow x:Class="Droprr.SendWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Droprr"
                 Title="Send with Droprr" Width="480" SizeToContent="Height" MinWidth="420" MinHeight="560"
                 WindowStartupLocation="CenterScreen" AllowDrop="True"
                 DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <local:PlatformSymbolConverter x:Key="PlatformSymbol" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <StackPanel>
        <ui:TitleBar x:Name="AppTitleBar" Title="Send with Droprr" ShowMaximize="False" />

        <StackPanel Margin="{StaticResource WindowPadding}">
            <!-- Devices -->
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}"
                           ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettings" />
                <TextBlock Text="Send to" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
            </DockPanel>

            <ListBox x:Name="PeerBox" MaxHeight="216" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Devices">
                <ListBox.ItemContainerStyle>
                    <!-- Device cards: rounded, hover fill, and when selected an accent border, tint, and pill.
                         The border is always 1 px, so selecting never shifts the layout. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                                    Margin="0,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:Peer}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0"
                                    Background="{DynamicResource AccentTintBrush}">
                                <ui:SymbolIcon Symbol="{Binding Platform, Converter={StaticResource PlatformSymbol}}" FontSize="16"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="{Binding ClearWaitingLabel}" AutomationProperties.Name="{Binding ClearWaitingLabel}"
                                       Click="OnClearWaiting">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding WaitingLabel}" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="Dismiss12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ui:Card x:Name="EmptyState" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap">
                    No devices yet.
                    <Hyperlink Click="OnSettings">Open Settings</Hyperlink>
                    to add one, or pair your iPhone with its QR code.
                </TextBlock>
            </ui:Card>

            <!-- Files -->
            <TextBlock Text="Files" Style="{StaticResource BodyStrongText}" Margin="0,16,0,8" />
            <Grid Height="152">
                <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                           Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                           Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <ListBox x:Name="FileList" DisplayMemberPath="Name" Margin="4" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Files to send" />
                <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Drop files or paste" Style="{StaticResource BodyStrongText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Ctrl+V pastes files or text from the clipboard" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="Add files…" Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Click="OnAddFiles" />
                <ui:Button Content="Clear" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Margin="4,0,0,0" Click="OnClearFiles" />
            </StackPanel>

            <!-- Text -->
            <TextBlock Text="Text or link" Style="{StaticResource BodyStrongText}" Margin="0,16,0,8" />
            <ui:TextBox x:Name="MessageText" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                        PlaceholderText="Type or paste text or a link" AutomationProperties.Name="Text or link" />

            <!-- Status -->
            <ProgressBar x:Name="Progress" Style="{StaticResource BrandProgressBar}" Visibility="Collapsed" Margin="0,16,0,0" />
            <ui:InfoBar x:Name="StatusBar" Margin="0,16,0,0" IsOpen="False" IsClosable="True" />

            <!-- Actions -->
            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <ui:Button Content="Paste" Icon="{ui:SymbolIcon ClipboardPaste24}" Appearance="Transparent"
                           ToolTip="Paste files or text (Ctrl+V)" Click="OnPaste" />
                <ui:Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Icon="{ui:SymbolIcon Send24}"
                           Appearance="Primary" IsDefault="True" ToolTip="Send (Ctrl+Enter)" Click="OnSend" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>

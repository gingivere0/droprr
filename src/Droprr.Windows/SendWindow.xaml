<ui:FluentWindow x:Class="Droprr.SendWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Send with Droprr" Width="480" Height="660" MinWidth="400" MinHeight="560"
                 WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Send with Droprr" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="{StaticResource WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="110" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}"
                           ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettings" />
                <TextBlock Text="Send to" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,16">
                <ui:Button x:Name="WaitingBadge" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Stretch"
                           Visibility="Collapsed" Click="OnClearWaiting" ToolTip="Clear the items waiting for this phone">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WaitingText" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="Dismiss12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
                <ComboBox x:Name="PeerBox" SelectionChanged="OnPeerChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <Border Grid.Row="2" CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <ListBox x:Name="FileList" DisplayMemberPath="Name" Margin="4" BorderThickness="0" Background="Transparent" />
                    <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Drop files here" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,16">
                <ui:Button Content="Add files…" Icon="{ui:SymbolIcon Add24}" Click="OnAddFiles" />
                <ui:Button Content="Clear" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="OnClearFiles" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Text or link" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8" />
            <ui:TextBox Grid.Row="5" x:Name="MessageText" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                        PlaceholderText="Type or paste text or a link" />

            <DockPanel Grid.Row="6" Margin="0,16,0,0" LastChildFill="False">
                <ui:Button Content="Paste" Icon="{ui:SymbolIcon ClipboardPaste24}" Click="OnPaste" />
                <ui:Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Icon="{ui:SymbolIcon Send24}"
                           Appearance="Primary" IsDefault="True" Click="OnSend" />
            </DockPanel>

            <StackPanel Grid.Row="7" Margin="0,12,0,0">
                <ProgressBar x:Name="Progress" Style="{StaticResource BrandProgressBar}" Visibility="Collapsed" Margin="0,0,0,8" />
                <TextBlock x:Name="EmptyState" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed">
                    No devices yet.
                    <Hyperlink Click="OnSettings">Open Settings</Hyperlink>
                    to add one, or pair your iPhone with its QR code.
                </TextBlock>
                <TextBlock x:Name="Status" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

<Application x:Class="Droprr.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF UI (lepoco/wpfui): Windows 11 styles for every control. AppTheme switches light and dark. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Droprr's design tokens (design-system/droprr/tokens.json) and type roles. -->
                <ResourceDictionary Source="Theming/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Styles based on WPF UI's live here, not in Tokens.xaml: a merged dictionary can't see the
                 styles in its sibling dictionaries when it loads, but the application dictionary can. -->
            <!-- The main action (Send, Pair a phone, Save): the theme's primaryButton and onPrimaryButton tokens. -->
            <Style x:Key="PrimaryActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryButtonBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource PrimaryButtonHoverBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}" />
                <Setter Property="PressedBackground" Value="{DynamicResource PrimaryButtonPressedBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource OnPrimaryButtonBrush}" />
                <Setter Property="PressedBorderBrush" Value="{DynamicResource PrimaryButtonPressedBrush}" />
                <Setter Property="CornerRadius" Value="{DynamicResource PrimaryButtonRadius}" />
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <!-- The secondary action (Send clipboard), in the window style's look (AppTheme.ApplyShapes): an
                 outlined pill (Material You), a raised pill (Clay), a frosted pill (Spatial), or an underlined
                 label (Atelier). Hover switches the label to textPrimary; disabled fades to 40%. Same height as the
                 primary button. -->
            <Style x:Key="TonalButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="{DynamicResource TonalBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TonalForegroundBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource TonalBorderThickness}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TonalBorderBrush}" />
                <Setter Property="CornerRadius" Value="{DynamicResource TonalRadius}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource TonalHoverBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource TonalBorderBrush}" />
                <Setter Property="PressedBackground" Value="{DynamicResource TonalPressedBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="16,8" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

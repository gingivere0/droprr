<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Droprr</AssemblyName>
    <RootNamespace>Droprr</RootNamespace>
    <Version>0.2.0</Version>
    <IconPack>..\..\file-swap-icon-pack\windows\</IconPack>
    <ApplicationIcon>$(IconPack)app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 suggests WinForms' ApplicationHighDpiMode instead of the manifest, but that only applies through
         WinForms' own startup. This is a WPF app (WinForms is only the tray icon), so the manifest sets DPI awareness. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(IconPack)app.ico" LogicalName="Droprr.app.ico" />
    <!-- The design system's tokens; ThemeCatalog reads the Bento themes from it. -->
    <EmbeddedResource Include="..\..\design-system\droprr\tokens.json" LogicalName="Droprr.tokens.json" />
    <None Include="settings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Droprr</AssemblyName>
    <RootNamespace>Droprr</RootNamespace>
    <Version>0.2.0</Version>
    <!-- The exe's icon (Explorer, Start menu, Alt+Tab before the app runs) is made from the default theme's logo
         by the MakeAppIcon target below. -->
    <AppIconSource>..\..\file-swap-icon-pack\themes\sage\logo-1024.png</AppIconSource>
    <ApplicationIcon>$(BaseIntermediateOutputPath)Droprr.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 suggests WinForms' ApplicationHighDpiMode instead of the manifest, but that only applies through
         WinForms' own startup. This is a WPF app (WinForms is only the tray icon), so the manifest sets DPI awareness. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The design system's tokens; ThemeCatalog reads the Bento themes from it. -->
    <EmbeddedResource Include="..\..\design-system\droprr\tokens.json" LogicalName="Droprr.tokens.json" />
    <!-- Each theme's logo, for the taskbar, title bar, and tray icons (AppIcon). -->
    <EmbeddedResource Include="..\..\file-swap-icon-pack\themes\graphiteLime\logo-1024.png" LogicalName="Droprr.logo.graphiteLime.png" />
    <EmbeddedResource Include="..\..\file-swap-icon-pack\themes\sunset\logo-1024.png" LogicalName="Droprr.logo.sunset.png" />
    <EmbeddedResource Include="..\..\file-swap-icon-pack\themes\cherry\logo-1024.png" LogicalName="Droprr.logo.cherry.png" />
    <EmbeddedResource Include="..\..\file-swap-icon-pack\themes\roseGold\logo-1024.png" LogicalName="Droprr.logo.roseGold.png" />
    <EmbeddedResource Include="..\..\file-swap-icon-pack\themes\sage\logo-1024.png" LogicalName="Droprr.logo.sage.png" />
    <EmbeddedResource Include="..\..\file-swap-icon-pack\themes\oliveMustard\logo-1024.png" LogicalName="Droprr.logo.oliveMustard.png" />
    <!-- Browser access's page, the same files the Mac app serves. -->
    <EmbeddedResource Include="..\..\web\index.html" LogicalName="Droprr.web.index.html" />
    <EmbeddedResource Include="..\..\web\app.js" LogicalName="Droprr.web.app.js" />
    <EmbeddedResource Include="..\..\web\app.css" LogicalName="Droprr.web.app.css" />
    <EmbeddedResource Include="..\..\web\icon.png" LogicalName="Droprr.web.icon.png" />
    <None Include="settings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Rebuilds obj\Droprr.ico when the logo or the script changes. -->
  <Target Name="MakeAppIcon" BeforeTargets="PrepareForBuild"
          Inputs="$(AppIconSource);..\..\scripts\make-app-icon.ps1" Outputs="$(ApplicationIcon)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;..\..\scripts\make-app-icon.ps1&quot; -Source &quot;$(AppIconSource)&quot; -Output &quot;$(ApplicationIcon)&quot;" />
  </Target>

</Project>

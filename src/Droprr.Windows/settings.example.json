{
  // Copy to %APPDATA%\Droprr\settings.json. Droprr creates that file with a
  // random token on first run, so usually you only need to add peers.
  "deviceName": "My PC",
  "port": 53318,
  "token": "REPLACE_WITH_A_LONG_RANDOM_TOKEN",
  // Leave null to save into Downloads\Droprr.
  "saveFolder": null,
  // Devices this PC can send to, by Tailscale (MagicDNS) hostname.
  // "token" is the receiving device's token; leave it empty if it matches yours.
  "peers": [
    {
      "name": "My Mac",
      "host": "my-mac",
      "port": 53318,
      "token": ""
    }
  ]
}

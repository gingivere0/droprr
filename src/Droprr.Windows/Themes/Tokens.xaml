<!--
    Droprr design tokens for Windows. Mirrors design-system/droprr/tokens.json (see MASTER.md there):
    change a value in tokens.json first, then here. Neutrals and semantic colors come from WPF UI's theme
    resources (TextFillColorPrimaryBrush, CardBackgroundFillColorDefaultBrush, and so on), not from here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- color.brand, color.accent, color.qrPlate -->
    <Color x:Key="BrandViolet">#5C21F7</Color>
    <Color x:Key="BrandCoral">#FF5E5C</Color>
    <Color x:Key="AccentTextLight">#5C21F7</Color>
    <Color x:Key="AccentTextDark">#A98BFF</Color>
    <SolidColorBrush x:Key="BrandCoralBrush" Color="{StaticResource BrandCoral}" />
    <SolidColorBrush x:Key="QrPlateBrush" Color="#FFFFFF" />

    <!-- font.family, font.role (Windows) -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>

    <!-- radius (Windows): small controls, buttons, and rows use WPF UI's default of 4 -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusFeature">12</CornerRadius>

    <!-- space: xs 4, sm 8, md 12, lg 16, xl 24, xxl 32 -->
    <Thickness x:Key="WindowPadding">24,4,24,24</Thickness>
    <Thickness x:Key="FeaturePadding">16</Thickness>

    <!-- Type roles -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyStrongText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Progress bars use the coral stop of the brand gradient. -->
    <Style x:Key="BrandProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource BrandCoralBrush}" />
    </Style>
</ResourceDictionary>

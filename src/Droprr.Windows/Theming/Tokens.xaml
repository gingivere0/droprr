<!--
    Droprr design tokens for Windows. Mirrors design-system/droprr/tokens.json (see MASTER.md there):
    change a value in tokens.json first, then here. Neutrals and semantic colors come from WPF UI's theme
    resources (TextFillColorPrimaryBrush, CardBackgroundFillColorDefaultBrush, and so on), not from here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Theme colors (accent fill, accent text, tint, secondary) come from the selected theme in
         ThemeCatalog.cs; AppTheme sets these brushes, so always use them as DynamicResource. The values
         below are only startup defaults. -->
    <SolidColorBrush x:Key="AccentTintBrush" Color="#808080" Opacity="0.12" />
    <!-- color.qrPlate -->
    <SolidColorBrush x:Key="QrPlateBrush" Color="#FFFFFF" />

    <!-- font.family, font.role (Windows) -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>

    <!-- radius (Windows): small controls, buttons, and rows use WPF UI's default of 4 -->
    <CornerRadius x:Key="RadiusFeature">12</CornerRadius>

    <!-- space: xs 4, sm 8, md 12, lg 16, xl 24, xxl 32 -->
    <Thickness x:Key="WindowPadding">24,4,24,24</Thickness>
    <Thickness x:Key="FeaturePadding">16</Thickness>

    <!-- Type roles -->
    <!-- Titles use the style's display type (Atelier's serif, Clay's heavy, and so on). -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="{DynamicResource DisplayFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="{DynamicResource DisplayFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyStrongText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Progress bars use the theme's secondaryText (raw secondary is decorative only). -->
    <Style x:Key="BrandProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
    </Style>

    <!-- Tiles (tokens.json "bento"): 16 px padding, 12 px apart. Their corners, borders, and shadow come from
         the window style below. RadiusTile is for small icon wells. -->
    <Thickness x:Key="TilePadding">16</Thickness>
    <CornerRadius x:Key="RadiusTile">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">4</CornerRadius>
    <!-- Window style (LookCatalog.cs, the same as apple/Shared/Looks.swift): AppTheme sets these for the chosen
         style, so always use them as DynamicResource. The values below are only startup defaults. -->
    <CornerRadius x:Key="LookTileRadius">24</CornerRadius>
    <Thickness x:Key="LookTileBorderThickness">1</Thickness>
    <x:Null x:Key="LookTileEffect" />
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontWeight x:Key="DisplayFontWeight">Normal</FontWeight>
    <CornerRadius x:Key="PrimaryButtonRadius">16</CornerRadius>
    <CornerRadius x:Key="TonalRadius">18</CornerRadius>
    <Thickness x:Key="TonalBorderThickness">1</Thickness>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource LookTileRadius}" />
        <Setter Property="Padding" Value="{StaticResource TilePadding}" />
        <Setter Property="BorderThickness" Value="{DynamicResource LookTileBorderThickness}" />
        <Setter Property="Effect" Value="{DynamicResource LookTileEffect}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <!-- Section titles in every window use the style's display family too, so a window never mixes title fonts. -->
    <Style x:Key="TileTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
    </Style>


    <!-- Small rounded labels, such as status chips in the Settings hero tile. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Windows app's Peers module (src/Droprr.Windows/Peers). The module only uses the base class
       library, so its files are compiled in directly and the tests run anywhere .NET does, without Windows. A file
       there that reaches outside the module breaks this build: that's the point. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Droprr.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Droprr.Windows\Peers\*.cs" Link="Peers\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>DroprrAppGroup</key>
	<string>$(DROPRR_MAC_APP_GROUP)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_droprr._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Droprr finds your other devices on this Wi-Fi network and sends to them directly, encrypted.</string>
</dict>
</plist>

{
  "$description": "Droprr design tokens. See MASTER.md for usage rules. Neutrals and semantic colors come from each platform.",
  "color": {
    "brand": {
      "violet": "#5C21F7",
      "coral": "#FF5E5C",
      "gradient": {
        "from": "#5C21F7",
        "to": "#FF5E5C",
        "angle": 135
      }
    },
    "accent": {
      "fill": "#5C21F7",
      "onFill": "#FFFFFF",
      "text": {
        "light": "#5C21F7",
        "dark": "#A98BFF"
      },
      "tintOpacity": {
        "light": 0.12,
        "dark": 0.2
      },
      "hoverOverlay": {
        "color": "#FFFFFF",
        "opacity": 0.18
      },
      "pressedOverlay": {
        "color": "#000000",
        "opacity": 0.15
      }
    },
    "qrPlate": "#FFFFFF"
  },
  "font": {
    "family": {
      "windows": "Segoe UI Variable",
      "apple": "SF Pro (system)",
      "monoWindows": "Cascadia Mono"
    },
    "role": {
      "title": {
        "windows": {
          "size": 28,
          "weight": 600
        },
        "apple": "title2"
      },
      "subtitle": {
        "windows": {
          "size": 20,
          "weight": 600
        },
        "apple": "title3.semibold"
      },
      "bodyStrong": {
        "windows": {
          "size": 14,
          "weight": 600
        },
        "apple": "headline"
      },
      "body": {
        "windows": {
          "size": 14,
          "weight": 400
        },
        "apple": "body"
      },
      "caption": {
        "windows": {
          "size": 12,
          "weight": 400
        },
        "apple": "caption"
      },
      "mono": {
        "windows": {
          "size": 12,
          "weight": 400
        },
        "apple": "caption.monospaced"
      }
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "smallControl": {
      "windows": 4,
      "mac": 6
    },
    "button": {
      "windows": 4,
      "mac": 7
    },
    "row": {
      "windows": 4,
      "mac": 8
    },
    "card": {
      "windows": 8,
      "mac": 12,
      "ios": 12
    },
    "feature": {
      "windows": 12,
      "mac": 14,
      "ios": 14
    }
  },
  "motion": {
    "fast": {
      "ms": 120,
      "easing": "ease-out"
    },
    "standard": {
      "ms": 200,
      "easing": "ease-out"
    },
    "slow": {
      "ms": 300,
      "easing": "ease-out"
    }
  },
